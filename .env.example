# ============================================================================
# ALGO TRADING BOT CONFIGURATION (.env.example)
# ============================================================================

# 1. Operational & Demo Settings
DRY_RUN="true"               # 'true' for paper trading / demo simulation; 'false' for live trading
POLL_INTERVAL_SEC="60"       # Polling interval in seconds

# 2. Trading Strategy Settings (4H Trend Rider)
SYMBOL="BTCUSD"              # Symbol format: 'BTCUSD' (Delta Exchange)
TIMEFRAME="4h"               # Strategy timeframe (4h)
RISK_PCT="1.5"               # Risk % of account equity per trade (default: 1.5%)
LEVERAGE="5"                 # Position leverage (e.g. 5x)

# Trailing Stop Configuration
TRAIL_PCT_ACTIVATION="1.0"   # Move 1.0% in profit triggers trailing stop
TRAIL_PCT_DISTANCE="0.4"     # Trail 0.4% behind peak price

# ----------------------------------------------------------------------------
# 3. Delta Exchange API Credentials (For Delta Exchange)
# ----------------------------------------------------------------------------
DELTA_API_KEY="your_delta_api_key"
DELTA_API_SECRET="your_delta_api_secret"
DELTA_BASE_URL="https://api.india.delta.exchange"

# ----------------------------------------------------------------------------
# 4. Telegram Notifier (optional)
# ----------------------------------------------------------------------------
# Get a bot token from @BotFather and the chat id from @userinfobot or via API
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Toggle notifications
TELEGRAM_ON_SIGNAL="true"
TELEGRAM_ON_EXECUTION="true"
TELEGRAM_ON_EXIT="true"

# ----------------------------------------------------------------------------
# 5. Cache limits (to limit disk usage)
# ----------------------------------------------------------------------------
# Max total cache size in MB (evict oldest when exceeded)
CACHE_MAX_SIZE_MB="200"
# Max cache age in days before eviction
CACHE_MAX_AGE_DAYS="90"
