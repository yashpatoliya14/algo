# ============================================================================
# GOLD HEDGE-GRID BOT CONFIGURATION (.env.example)
#   XAUTUSD SuperTrend + PAXGUSD hedge grid — copy to .env and fill in.
# ============================================================================

# 1. Operational settings
# 'true' = paper/simulation (no real orders); 'false' = LIVE real trading
DRY_RUN="true"
# Seconds between polls (live samples mark price each poll)
POLL_INTERVAL_SEC="60"
# Used only to show INR alongside USD PnL in Telegram
USD_INR_RATE="86.5"

# WebSocket feed tuning (live trader is push-driven, not fixed-interval polling)
# Refuse to trade if the feed has been silent longer than this (seconds)
STALE_AFTER_SEC="90"
# Throttle floor between decision cycles (seconds)
WS_MIN_CYCLE_SEC="1"
# Wake the loop at least this often even in a quiet market (seconds)
SAFETY_TICK_SEC="5"
# Throttle the routine status log line (seconds)
LOG_INTERVAL_SEC="30"

# 2. Strategy — instruments & signal
# Directional leg (the only signal generator)
MAIN_SYMBOL="XAUTUSD"
# Counter-hedge grid leg (correlated gold token)
HEDGE_SYMBOL="PAXGUSD"
# Candle timeframe for SuperTrend
TIMEFRAME="1h"
# SuperTrend ATR period
ST_PERIOD="10"
# SuperTrend ATR multiplier
ST_MULT="3.0"

# 3. Strategy — sizing & grid
# Main-leg size in lots (1 lot = 1 contract = 0.001 oz)
MAIN_LOTS="10"
# Hedge lots opened per grid step
HEDGE_LOTS_PER_STEP="1"
# Max simultaneously open hedge lots
HEDGE_MAX_LOTS="5"
# Grid step size, % of entry (each step adds one hedge lot)
STEP_PCT="0.5"
# Take-profit on the main leg, % (flattens everything)
TP_PCT="5.0"
# Position leverage set on the exchange
LEVERAGE="5"

# ----------------------------------------------------------------------------
# 4. Delta Exchange API credentials
# ----------------------------------------------------------------------------
DELTA_API_KEY="your_delta_api_key"
DELTA_API_SECRET="your_delta_api_secret"
DELTA_BASE_URL="https://api.india.delta.exchange"

# ----------------------------------------------------------------------------
# 5. Telegram notifier (optional)
#    Bot token from @BotFather; chat id from @userinfobot. Leave blank to disable.
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ON_SIGNAL="true"
TELEGRAM_ON_EXECUTION="true"
TELEGRAM_ON_EXIT="true"
