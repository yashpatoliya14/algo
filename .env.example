# ============================================================================
# GOLD HEDGE-GRID BOT CONFIGURATION (.env.example)
#   XAUTUSD SuperTrend + PAXGUSD hedge grid — copy to .env and fill in.
# ============================================================================

# 1. Operational settings
DRY_RUN="true"               # 'true' = paper/simulation (no real orders); 'false' = LIVE real trading
POLL_INTERVAL_SEC="60"       # Seconds between polls (live samples mark price each poll)
USD_INR_RATE="86.5"          # Used only to show INR alongside USD PnL in Telegram

# 2. Strategy — instruments & signal
MAIN_SYMBOL="XAUTUSD"        # Directional leg (the only signal generator)
HEDGE_SYMBOL="PAXGUSD"       # Counter-hedge grid leg (correlated gold token)
TIMEFRAME="4h"               # Candle timeframe for SuperTrend
ST_PERIOD="10"               # SuperTrend ATR period
ST_MULT="3.0"                # SuperTrend ATR multiplier

# 3. Strategy — sizing & grid
MAIN_LOTS="10"               # Main-leg size in lots (1 lot = 1 contract = 0.001 oz)
HEDGE_LOTS_PER_STEP="1"      # Hedge lots opened per grid step
HEDGE_MAX_LOTS="5"           # Max simultaneously open hedge lots
STEP_PCT="1.0"               # Grid step size, % of entry (each step adds one hedge lot)
TP_PCT="10.0"                # Take-profit on the main leg, % (flattens everything)
LEVERAGE="5"                 # Position leverage set on the exchange

# ----------------------------------------------------------------------------
# 4. Delta Exchange API credentials
# ----------------------------------------------------------------------------
DELTA_API_KEY="your_delta_api_key"
DELTA_API_SECRET="your_delta_api_secret"
DELTA_BASE_URL="https://api.india.delta.exchange"

# ----------------------------------------------------------------------------
# 5. Telegram notifier (optional)
#    Bot token from @BotFather; chat id from @userinfobot. Leave blank to disable.
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ON_SIGNAL="true"
TELEGRAM_ON_EXECUTION="true"
TELEGRAM_ON_EXIT="true"
